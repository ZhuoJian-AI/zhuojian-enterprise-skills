{
  "protocol": "zhuojian-subsystem",
  "version": 2,
  "contractRevision": "2.5",
  "enterprise": {"key": "example", "name": "合成契约测试企业（非部署配置）"},
  "applicationSlug": "workflow-contract-fixture",
  "applicationName": "流程协议合成测试（无已上线业务实现）",
  "bridgeVersion": 1,
  "presentation": {"moduleNavigationTheme": {
    "accentColor": "#176B57", "backgroundColor": "#FFFAF1",
    "selectedBackgroundColor": "#E8F4EF", "selectedTextColor": "#174F43"
  }},
  "eventsUrl": "/api/integration/events",
  "eventDeliveriesUrl": "/api/integration/event-deliveries",
  "auth": {"ssoPath": "/api/integration/sso", "mode": "authorization_code"},
  "modules": [{
    "moduleKey": "records", "name": "合成记录", "route": "/records",
    "departments": [{"key": "operations", "name": "示例业务部门", "role": "owner"}],
    "accessRoles": [{"roleKey": "records.viewer", "name": "合成查看者", "pageKeys": ["records.list"], "actionKeys": ["records.check"]}],
    "pages": [{
      "pageKey": "records.list", "name": "记录列表", "routePattern": "/records",
      "queryActionKey": "records.check", "actionKeys": ["records.check"],
      "contextSchema": {"type": "object", "additionalProperties": false, "properties": {
        "route": {"type": "string", "pattern": "^/(?!/).*$"},
        "entity_type": {"type": "string"}, "entity_id": {"type": "string"},
        "filters": {"type": "object"}, "selection": {"type": "object"},
        "data_version": {"type": ["string", "number"]}
      }},
      "aiSemantics": {
        "purpose": "演示如何登记当前记录的只读检查与处理流程；此 fixture 不代表任何生产检查已实现。",
        "primaryEntities": ["record"], "fieldSemantics": [],
        "supportedIntents": ["检查当前记录并解释下一步"], "relatedPages": [], "businessTerms": [],
        "defaultQueryActionKey": "records.check", "defaultInteractionAnchorKey": "records_results",
        "interactionAnchors": [{"anchorKey": "records_results", "name": "记录结果", "description": "当前获权记录的检查结果", "actionKeys": ["records.check"]}],
        "workflowGuides": [{
          "workflowKey": "review-record-evidence", "name": "检查记录并处理待核实项",
          "goal": "先查当前获权记录，说明实际待核实项及人工处理入口，不凭流程描述宣称记录已完成。",
          "whenToUse": "员工正在查看记录，希望知道当前可做什么时。",
          "steps": [{
            "stepKey": "inspect", "title": "读取当前状态", "purpose": "获取本次真实的检查结果与版本",
            "moduleKey": "records", "pageKey": "records.list", "actionKeys": ["records.check"],
            "preconditions": ["记录在当前员工获准范围内"],
            "completionCriteria": ["收到有效 assistantCheck 及对应 dataVersion"]
          }, {
            "stepKey": "review", "title": "查看依据后决定", "purpose": "员工核对证据；无写入工具时保留人工处理",
            "moduleKey": "records", "pageKey": "records.list", "actionKeys": [],
            "preconditions": ["存在本次检查结果，不把失败当作无异常"],
            "completionCriteria": ["员工看到检查摘要和仍需人工核实的事项"]
          }],
          "exceptions": ["查询失败、权限变化或版本过期时停止使用旧结论，保留人工入口"]
        }],
        "proactiveCheck": {"actionKey": "records.check", "intervalSeconds": 90}
      }
    }],
    "actions": [{
      "actionKey": "records.check", "name": "检查当前记录", "description": "合成只读契约：只能读取当前员工当前页面可见的记录并返回有界建议。",
      "operation": "query", "aiEnabled": true, "requiresConfirmation": false,
      "permissionPolicy": {"group": "personal", "mode": "self"},
      "aiTool": {
        "whenToUse": "需要查询当前记录的检查摘要时。", "whenNotToUse": "需要修改、审批或查询其他员工记录时。",
        "preconditions": ["当前记录仍在员工权限范围内"], "sideEffects": "无业务写入、通知或模型调用。",
        "examples": [{"userRequest": "看看当前记录还有什么待核实", "params": {"context": {}}}],
        "confirmationPrompt": "本操作只读，不要求写入确认。"
      },
      "inputSchema": {
        "type": "object", "additionalProperties": false, "required": ["context"],
        "properties": {"context": {"type": "object", "additionalProperties": false, "properties": {
          "route": {"type": "string", "pattern": "^/(?!/).*$"},
          "entity_type": {"type": "string"}, "entity_id": {"type": "string"},
          "filters": {"type": "object"}, "selection": {"type": "object"},
          "data_version": {"type": ["string", "number"]}
        }}}
      },
      "resultSchema": {
        "type": "object", "additionalProperties": false, "required": ["assistantCheck"],
        "properties": {"assistantCheck": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "dataVersion", "summary", "suggestions"],
          "properties": {
            "version": {"type": "integer", "const": 1},
            "dataVersion": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
            "summary": {"type": "string", "minLength": 1, "maxLength": 400, "pattern": "\\S"},
            "suggestions": {"type": "array", "maxItems": 3, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "revision", "title", "summary", "goal"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},
                "revision": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},
                "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
                "summary": {"type": "string", "minLength": 1, "maxLength": 400, "pattern": "\\S"},
                "goal": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}
              }
            }}
          }
        }}
      }
    }]
  }]
}
