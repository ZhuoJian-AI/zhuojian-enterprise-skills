[Unit]
Description=Consistent backup of ZhuoJian-managed module data
After=docker.service local-fs.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zhuojian-runtime backup-all
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Backup/recovery persists release state and temporarily installs the per-app
# maintenance route. nginx -t also opens its existing log/pid paths.
ReadWritePaths=/srv/zhuojian/backups /srv/zhuojian/deployments /etc/nginx/conf.d /var/log/nginx -/run/nginx.pid /run/lock /run/docker.sock
TimeoutStartSec=4h
