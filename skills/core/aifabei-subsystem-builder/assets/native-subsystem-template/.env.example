# Runtime 在部署时自动注入下列四类项目凭证；业务负责人无需填写或查看。
ZHUOJIAN_MANIFEST_ACCESS_TOKEN=
ZHUOJIAN_SSO_EXCHANGE_TOKEN=
ZHUOJIAN_ACTION_SIGNING_SECRET=
ZHUOJIAN_EVENT_SIGNING_SECRET=
SESSION_SECRET=
ZHUOJIAN_ORGANIZATION_ID=
ZHUOJIAN_PUBLIC_ORIGIN=https://example.aifabei.example.com
ZHUOJIAN_SAAS_ORIGINS=https://ai-platform.staging.zhuojianai.com
ZHUOJIAN_SAAS_ORIGIN=https://ai-platform.staging.zhuojianai.com
DATABASE_PATH=/data/subsystem.db
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=/data/files
# 本地模式固定写入数据卷；切换 OSS 时管理员 Runtime 会自动改为 oss-gateway 并注入下列两项。
FILE_STORAGE_GATEWAY_URL=
FILE_STORAGE_TOKEN=
FILE_STORAGE_GATEWAY_TIMEOUT_SECONDS=900
FILE_STORAGE_MAX_UPLOAD_BYTES=536870912
FILE_STORAGE_SPOOL_DIR=/data/files/.tmp
# Production Runtime injects its read-only disk gate here. Leave blank only for local development.
FILE_STORAGE_STATE_FILE=
FILE_STORAGE_UPLOAD_LOCK_FILE=
FILE_STORAGE_RECOVERY_GRACE_SECONDS=1800
FILE_STORAGE_RECOVERY_IO_TIMEOUT_SECONDS=5
# 兼容旧版模块；新 Runtime 使用上面的 FILE_STORAGE_* 变量。
STORAGE_GATEWAY_URL=
STORAGE_PROJECT_TOKEN=
ZHUOJIAN_IMAGE_NAME=zhuojian/aifabei/example:local
ZHUOJIAN_DATA_DIR=/srv/zhuojian/data/example
ZHUOJIAN_APP_PORT=18000
